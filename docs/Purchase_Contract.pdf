               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>STAMP AND SIGNATURE OF  THE ESCROW AGENT         </photoshop:LayerName>
                  <photoshop:LayerText>STAMP AND SIGNATURE OF  THE ESCROW AGENT         </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
